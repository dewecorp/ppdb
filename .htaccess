Options -Indexes -MultiViews

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Rule 1: Redirect /index and /index.php to the base directory ./
    RewriteRule ^index(\.php)?$ ./ [R=301,L]

    # Rule 2: Externally redirect to remove .php extension
    # This rule only runs for direct browser requests for .php files
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\s([^?#\s]+)\.php[?#\s]
    RewriteRule ^(.*)\.php$ %1 [R=301,L]

    # Rule 3: Internally rewrite pretty URL to actual .php file
    # This runs after the browser has been redirected
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.php -f
    RewriteRule ^(.*)$ $1.php [L]
</IfModule>
