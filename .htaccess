DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Blok folder WordPress palsu/backdoor pada aplikasi PPDB non-WordPress.
    RewriteRule ^(wp-admin|wp-content|wp-includes)(/|$) - [F,L,NC]

    # Blok folder internal tool/repository dan endpoint updater web.
    RewriteRule ^(\.git|\.qoder|\.agents|\.codex)(/|$) - [F,L,NC]
    RewriteRule ^admin/api/update_system\.php$ - [F,L,NC]

    # Jangan izinkan script berbahaya dari folder writable/static.
    RewriteRule ^(uploads|backups|assets)/.*\.(php[0-9]?|phtml|phar|shtml|cgi|pl|py|sh)$ - [F,L,NC]

    # File backup/arsip tidak boleh diunduh langsung dari web.
    RewriteRule ^backups/ - [F,L,NC]

    # Bersihkan akses langsung ke index.php tanpa mengganggu proses POST.
    RewriteCond %{REQUEST_METHOD} GET [NC]
    RewriteCond %{THE_REQUEST} \s/+index\.php[?\s] [NC]
    RewriteRule ^index\.php$ ./ [R=301,L]

    RewriteCond %{REQUEST_METHOD} GET [NC]
    RewriteCond %{THE_REQUEST} \s/+(.+)/index\.php[?\s] [NC]
    RewriteRule ^(.+)/index\.php$ $1/ [R=301,L]

    # Tampilkan URL tanpa .php untuk link GET, tetapi biarkan form POST tetap aman.
    RewriteCond %{REQUEST_METHOD} GET [NC]
    RewriteCond %{THE_REQUEST} \s/+(.+)\.php[?\s] [NC]
    RewriteRule ^(.+)\.php$ $1 [R=301,L]

    # Route admin eksplisit supaya LiteSpeed tidak menolak URL tanpa .php.
    RewriteRule ^admin/?$ admin/index.php [L,QSA]
    RewriteRule ^admin/login/?$ admin/login.php [L,QSA]
    RewriteRule ^admin/logout/?$ admin/logout.php [L,QSA]
    RewriteRule ^admin/(cetak_kartu|cetak_semua_kartu|download_backup|export_pendaftar_excel|laporan_pendaftar)(/)?$ admin/$1.php [L,QSA]

    # Route admin singkat: /admin/pendaftar -> /admin/index.php?page=pendaftar
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^admin/(dashboard|madrasah|pendaftar|pengaturan|pengguna|backup)$ admin/index.php?page=$1 [L,QSA]

    # Extensionless PHP: /data_pendaftar -> /data_pendaftar.php
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.+)$ $1.php [L,QSA]
</IfModule>

<FilesMatch "(^\.|\.(bak|config|dist|env|ini|log|old|orig|save|sql|swp|zip)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>
