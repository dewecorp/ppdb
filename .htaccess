Options -Indexes -MultiViews

<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # 1. Handle trailing slash (optional but recommended for CI style)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)/$ $1 [L,R=301]

    # 2. Redirect /index and /index.php to root ./
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index(\.php)?\ HTTP/
    RewriteRule ^index(\.php)?$ ./ [R=301,L]

    # 3. Handle admin subfolder specifically
    # Admin pages like /admin/dashboard -> /admin/index.php?page=dashboard
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^admin/(dashboard|madrasah|pendaftar|pengaturan|pengguna|backup)$ admin/index.php?page=$1 [L,QSA]

    # 4. Standard CI style: Remove index.php from URL
    # This will rewrite /admin/login to /admin/login.php internally
    # and /data_pendaftar to /data_pendaftar.php internally
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.*)$ $1.php [L]

    # 5. Handle /admin/ to /admin/index.php internally if it's a directory
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteCond %{REQUEST_FILENAME}/index.php -f
    RewriteRule ^(.*)$ $1/index.php [L]
</IfModule>

# Ensure correct MIME types for font files on some hosts
AddType application/font-woff2 .woff2
AddType application/font-woff .woff
AddType application/vnd.ms-fontobject .eot
AddType font/ttf .ttf
AddType image/svg+xml .svg
